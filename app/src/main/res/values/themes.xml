<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="arka">#0B0F14</color>
    <color name="kart">#161C24</color>
    <color name="kart_seffaf">#B3161C24</color>
    <color name="kart_basili">#E626313F</color>
    <color name="perde">#33000000</color>
    <color name="vurgu">#3DA9FC</color>
    <color name="yazi">#F2F5F8</color>
    <color name="soluk">#A9B4C0</color>

    <!-- Uygulama listesi: düz koyu arka plan -->
    <style name="AracTema" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/arka</item>
        <item name="android:statusBarColor">@color/arka</item>
        <item name="android:navigationBarColor">@color/arka</item>
        <item name="android:colorAccent">@color/vurgu</item>
        <item name="android:textColor">@color/yazi</item>
    </style>

    <!-- Ana ekran: arkada cihazın duvar kağıdı görünür -->
    <style name="AracTema.Duvar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
