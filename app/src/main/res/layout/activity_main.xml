<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/perde"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp">

    <!-- Üst satır: saat/tarih + hava durumu (kutusuz) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/saatAlani"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/saat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:shadowColor="#80000000"
                android:shadowRadius="8"
                android:text="00:00"
                android:textColor="@color/yazi"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/tarih"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#80000000"
                android:shadowRadius="6"
                android:textColor="@color/yazi"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/havaKart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingBottom="2dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/havaIkon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_gunes" />

                <TextView
                    android:id="@+id/sicaklik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#80000000"
                    android:shadowRadius="6"
                    android:text="--°"
                    android:textColor="@color/yazi"
                    android:textSize="30sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/havaDurum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowRadius="6"
                android:text="Hava durumu"
                android:textColor="@color/yazi"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- İkon ızgarası (kodla doldurulur: 3 satır x 4 sütun) -->
    <LinearLayout
        android:id="@+id/dok"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="6"
        android:orientation="vertical" />

    <!-- Müzik şeridi -->
    <LinearLayout
        android:id="@+id/muzikKart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1.35"
        android:background="@drawable/kart_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/sarkiBilgi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/kapak"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/kapak_bg"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_muzik" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/kaynak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Müzik"
                        android:textColor="@color/vurgu"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/sarki"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Şu an çalan yok"
                        android:textColor="@color/yazi"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/sanatci"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/soluk"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/onceki"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/oynat"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▶"
                android:textColor="#07121C"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/sonraki"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/yazi"
                android:textSize="24sp" />

            <View
                android:id="@+id/ayrac"
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:background="#55FFFFFF" />

            <ImageView
                android:id="@+id/navBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="13dp"
                android:src="@drawable/ic_nav_ok" />

            <ImageView
                android:id="@+id/telBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="13dp"
                android:src="@drawable/ic_telefon" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/ilerleme"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progress="0" />

        <TextView
            android:id="@+id/gecen"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/toplam"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Ünitenin altta her zaman duran klima çubuğu için boşluk -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.95" />
</LinearLayout>
