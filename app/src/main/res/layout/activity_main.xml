<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/perde"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="0dp">

    <!-- Saat / tarih + hava durumu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/saatAlani"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/saat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:autoSizeMaxTextSize="140sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-light"
                android:gravity="start|bottom"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowRadius="8"
                android:text="00:00"
                android:textColor="@color/yazi" />

            <TextView
                android:id="@+id/tarih"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="30sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:gravity="start|top"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:textColor="@color/yazi" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/havaKart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="2"
            android:background="@drawable/kart_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/sicaklik"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="--°"
                android:textColor="@color/yazi" />

            <TextView
                android:id="@+id/havaDurum"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="Hava durumu"
                android:textColor="@color/soluk" />
        </LinearLayout>
    </LinearLayout>

    <!-- Çalan müzik -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="5.2"
        android:background="@drawable/kart_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/sarkiBilgi"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/kapak"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/kapak_bg"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_muzik" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="3"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/kaynak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Müzik"
                    android:textColor="@color/vurgu"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/sarki"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:text="Şu an çalan yok"
                    android:textColor="@color/yazi"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/sanatci"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/soluk"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/ilerleme"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/vurgu" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gecen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/soluk"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/toplam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0:00"
                android:textColor="@color/soluk"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1.3"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/onceki"
                style="@style/MedyaButon"
                android:layout_marginEnd="7dp"
                android:text="⏮" />

            <TextView
                android:id="@+id/oynat"
                style="@style/MedyaButon"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:text="▶" />

            <TextView
                android:id="@+id/sonraki"
                style="@style/MedyaButon"
                android:layout_marginStart="7dp"
                android:text="⏭" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kısayollar (ilk sırada navigasyon) -->
    <LinearLayout
        android:id="@+id/dok"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1.4"
        android:background="@drawable/kart_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp" />

    <!-- Tüm uygulamalar -->
    <TextView
        android:id="@+id/uygulamalar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="0.7"
        android:autoSizeMaxTextSize="26sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/buton_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="1"
        android:padding="8dp"
        android:text="Tüm uygulamalar"
        android:textColor="@color/yazi" />

    <!-- Ünitenin altta her zaman duran klima çubuğu için boşluk -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8" />
</LinearLayout>
