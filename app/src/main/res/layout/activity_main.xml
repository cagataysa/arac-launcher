<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/perde"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp">

    <!-- Üst satır: saat/tarih + hava durumu (kutusuz) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/saatAlani"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/saat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:shadowColor="#80000000"
                android:shadowRadius="8"
                android:text="00:00"
                android:textColor="@color/yazi"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/tarih"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#80000000"
                android:shadowRadius="6"
                android:textColor="@color/yazi"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/havaKart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingBottom="2dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/havaIkon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_gunes" />

                <TextView
                    android:id="@+id/sicaklik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#80000000"
                    android:shadowRadius="6"
                    android:text="--°"
                    android:textColor="@color/yazi"
                    android:textSize="30sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/havaDurum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowRadius="6"
                android:text="Hava durumu"
                android:textColor="@color/yazi"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Çalan müzik: kapak üstte, yazılar ortada, tuşlar altta -->
    <LinearLayout
        android:id="@+id/muzikKart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="4.5"
        android:background="@drawable/kart_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/sarkiBilgi"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/kapak"
                android:layout_width="160dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/kapak_bg"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_muzik" />

            <TextView
                android:id="@+id/kaynak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="Müzik"
                android:textColor="@color/vurgu"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sarki"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="Şu an çalan yok"
                android:textColor="@color/yazi"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/sanatci"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/soluk"
                android:textSize="16sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/ilerleme"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gecen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/soluk"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/toplam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/soluk"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/onceki"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⏮"
                android:textColor="@color/yazi"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/oynat"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/yazi"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/sonraki"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/yazi"
                android:textSize="30sp" />
        </LinearLayout>

        <!-- Bu tasarımda kullanılmayan (kod uyumu için gizli) -->
        <View android:id="@+id/ayrac" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/navBtn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/telBtn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>

    <!-- Kısayollar: 4 büyük ikon + Tümü (kodla doldurulur) -->
    <LinearLayout
        android:id="@+id/dok"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1.5"
        android:background="@drawable/kart_bg"
        android:orientation="vertical"
        android:padding="6dp" />

    <!-- Ünitenin altta her zaman duran klima çubuğu için boşluk -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75" />
</LinearLayout>
