<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Uygulamalar"
        android:textColor="@color/yazi"
        android:textSize="30sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="Uzun bas: ana ekran kısayollarına ekle / çıkar"
        android:textColor="@color/soluk"
        android:textSize="16sp" />

    <GridView
        android:id="@+id/izgara"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnWidth="120dp"
        android:horizontalSpacing="10dp"
        android:numColumns="auto_fit"
        android:stretchMode="columnWidth"
        android:verticalSpacing="10dp" />

    <TextView
        android:id="@+id/geri"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/buton_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Ana ekrana dön"
        android:textColor="@color/yazi"
        android:textSize="22sp" />
</LinearLayout>
